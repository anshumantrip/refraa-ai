NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/refraa
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# Set only when a trusted reverse proxy strips client-supplied forwarding headers.
TRUST_PROXY_HOPS=0

# Authenticated SMTP, e.g. Amazon SES or Postmark. Port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional separate MongoDB server/credentials for integration tests. A unique test database is used.
TEST_MONGODB_URI=
# Optional installed browser channel for the browser integration test (e.g. chrome or msedge).
BROWSER_CHANNEL=
# Alternatively, set the path to a Chromium executable.
BROWSER_EXECUTABLE=

# Phase 3. Provision a private S3-compatible bucket and durable Redis.
RESUME_S3_BUCKET=
RESUME_S3_REGION=us-east-1
RESUME_S3_ENDPOINT=
RESUME_S3_PATH_STYLE=false
# Optional when using the AWS SDK's default credential chain.
RESUME_S3_ACCESS_KEY=
RESUME_S3_SECRET_KEY=
RESUME_REDIS_URL=
RESUME_QUEUE_NAME=refraa-resumes
RESUME_FILE_MB=10
RESUME_BATCH_MB=4096
RESUME_UPLOAD_CONCURRENCY=8
RESUME_WORKER_CONCURRENCY=3
RESUME_WORKER_ATTEMPTS=4
# Zero disables automatic expiration.
RESUME_RETENTION_DAYS=0
RESUME_CLAMAV_HOST=
RESUME_CLAMAV_PORT=3310
RESUME_REQUIRE_SCAN=false

# Matching service and worker
MATCH_AI_URL=
MATCH_AI_TOKEN=
MATCH_QUEUE_NAME=refraa-matching
MATCH_SIMILARITY=0.65
MATCH_MIN_SCORE=35
MATCH_MAX_CANDIDATES=10000
# Optional Atlas index on matchingvectors
MATCH_ATLAS_INDEX=
# FastAPI service settings (pass to the Python process environment)
MATCH_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCH_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
MATCH_MODEL_OFFLINE=false
MATCH_DEVICE=cpu
