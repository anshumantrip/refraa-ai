{
  "name": "refraa-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "worker:resumes": "node --env-file-if-exists=.env server/resumes/worker.js",
    "worker:matching": "node --env-file-if-exists=.env server/matching/worker.js",
    "worker:notifications": "node --env-file-if-exists=.env server/referrals/worker.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "test": "node --test test/unit.test.js test/resumes.unit.test.js test/matching.unit.test.js test/referrals.unit.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration.test.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "org:configure": "node --env-file-if-exists=.env server/operator.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  }
}
